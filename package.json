{
  "name": "agentproxy",
  "version": "0.2.0",
  "description": "AgentProxy desktop app: 20 proxies per public IP, local forward proxy + clean UI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node smoke.js",
    "vpn:fetch": "node vpn/fetch-singbox.js",
    "vpn:smoke": "node tools/vpn-poc-smoke.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.agentproxy.app",
    "productName": "AgentProxy",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "vpn/scripts/**/*",
      "vpn/bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/favicon.png"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/favicon.png",
      "artifactName": "AgentProxy-${version}-${arch}.${ext}",
      "identity": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AgentProxy-Setup-${version}.exe",
      "shortcutName": "AgentProxy"
    },
    "portable": {
      "artifactName": "AgentProxy-Portable-${version}.exe"
    }
  }
}
